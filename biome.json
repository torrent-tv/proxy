{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"files": {
		"includes": [
			"**/*.js",
			"!**/node_modules/**"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUndeclaredVariables": "error",
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noInvalidUseBeforeDeclaration": "error",
				"noPrivateImports": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"services/demand/**",
				"services/segment-formats/**",
				"services/tracks/**",
				"services/output/**",
				"services/viewer/**",
				"services/encode/**",
				"services/priority/**",
				"services/source/**",
				"services/torrent/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../**"
										],
										"message": "This layer states facts and imports nothing above itself. Anything it needs from outside — a logger, a clock, a way to read bytes — is passed in."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"services/storage/**",
				"services/piece-store/**",
				"services/segment-store/**",
				"services/files/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../**",
											"!../storage/**",
											"!../piece-store/**",
											"!../segment-store/**",
											"!../files/**"
										],
										"message": "ONE LAYER, FOUR DIRECTORIES — bytes on a medium with a limit. What is held in memory (piece-store/), the produced segments (segment-store/), whole downloaded files (files/), and the one owner of the room all three take (storage/). They may reach each other and nothing above. Written as an exception to `../**` rather than as a list of forbidden layers, because a layer is not a directory: the blanket form cannot say \"my siblings\", and a list of names misses everything it forgets — `../../utils/logger.js` went straight through one on 2026-09-14."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"services/quality/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../hls-session-manager.js",
											"../controllers/**",
											"../orchestrators/**",
											"../container/**",
											"../demand/**",
											"../download/**",
											"../storage/**",
											"../piece-store/**",
											"../segment-store/**",
											"../files/**",
											"../segment-formats/**",
											"../torrent-worker/**",
											"../viewer/**",
											"../output/**"
										],
										"message": "What encoding costs is arithmetic over readings. Which sessions belong to one file, how many encoders run, what a file costs to fetch — all of it is passed in, so this can be asked without a session manager, a torrent or a disk."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"services/download/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../*",
											"../container/**",
											"../controllers/**",
											"../encode/**",
											"../orchestrators/**",
											"../output/**",
											"../segment-formats/**",
											"../torrent-worker/**",
											"../tracks/**",
											"../viewer/**"
										],
										"message": "What the swarm is told is decided from what is wanted (demand/) and what is held (storage/), and from nothing else."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"services/container/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../*",
											"../controllers/**",
											"../demand/**",
											"../download/**",
											"../encode/**",
											"../orchestrators/**",
											"../output/**",
											"../storage/**",
											"../piece-store/**",
											"../segment-store/**",
											"../files/**",
											"../segment-formats/**",
											"../torrent-worker/**",
											"../viewer/**"
										],
										"message": "A container answers for itself and hands out tracks/. It knows nothing of torrents, encoders or viewers: the four functions it is built with are its whole outside world."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"services/orchestrators/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../*",
											"../controllers/**",
											"../demand/**",
											"../download/**",
											"../output/**",
											"../storage/**",
											"../piece-store/**",
											"../segment-store/**",
											"../files/**",
											"../segment-formats/**",
											"../viewer/**"
										],
										"message": "An orchestrator composes the layers below it. Reaching sideways into serving or downloading is what put a scenario in two places before."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"services/controllers/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../*",
											"../demand/**",
											"../download/**",
											"../encode/**",
											"../output/**",
											"../storage/**",
											"../piece-store/**",
											"../segment-store/**",
											"../files/**",
											"../segment-formats/**",
											"../torrent-worker/**",
											"../viewer/**"
										],
										"message": "A controller translates a request for an orchestrator. Every layer below the orchestrator is reached through it, never around it."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"services/torrent-worker/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"../hls-session-manager.js",
											"../controllers/**",
											"../encode/**",
											"../output/**",
											"../viewer/**",
											"../segment-formats/**"
										],
										"message": "The torrent thread serves bytes. What is produced from them, and for whom, is decided in the main thread and never asked of this one."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
